# Plantilla de configuración para ejecución local en Windows (PowerShell)
# 1. Copie este archivo con el nombre "run-local.ps1" en la raíz del proyecto.
# 2. Reemplace los valores de ejemplo con sus credenciales locales.
# 3. Ejecute el proyecto con: .\run-local.ps1

$env:GEMINI_API_KEYS = "TU_API_KEY_DE_GEMINI"
$env:JWT_SECRET = "reemplazar-por-una-clave-secreta-segura-de-al-menos-32-caracteres"
$env:ADMIN_EMAIL = "admin@minomina.local"

mvn spring-boot:run

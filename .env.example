# Variables de entorno de ejemplo para Mi Nómina
# Copie este archivo como .env y configure sus propios valores antes de ejecutar.

SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=reemplazar-por-una-clave-secreta-segura-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=604800000
GEMINI_API_KEYS=TU_API_KEY_DE_GEMINI
ADMIN_EMAIL=admin@minomina.local
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500

# Configuración exclusiva para el perfil de producción (SPRING_PROFILES_ACTIVE=prod)
DB_URL=jdbc:postgresql://localhost:5432/minomina
DB_USER=minomina
DB_PASSWORD=cambiar_password_seguro
